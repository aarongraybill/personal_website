{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "_site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/whats-playing",
        "function": {
          "functionId": "whatsPlaying",
          "region": "us-west1",
          "pinTag": true
        }
      }
    ]
  }
}
